  "vulnerabilities": [
    {
      "cve": "CVE-2026-135278",
      "cwe": {
        "id": "CWE-613",
        "name": "Insufficient Session Expiration"
      },
      "notes": [
        {
          "category": "description",
          "text": "Affected versions of Mendix Runtime do not end existing sessions when a user account is set to inactive. The account state is checked at sign-in, but not on later requests made with a session that already exists. A user who is deactivated while signed in can keep using that session for as long as the client keeps it alive.\r\n\r\nThis could allow an authenticated remote attacker to read and change data within previous permissions for a persistent session.",
          "title": "CVE Description"
        }
      ],
